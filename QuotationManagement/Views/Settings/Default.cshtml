@model QuotationManagement.Models.ViewModels.View_BranchDefaultSettings

@{
}

<link rel="stylesheet" href="~/css/branch-default-settings.css" />

<div class="wrapper section-wrapper">
	<div class="branch-option">
		<label for="branch-option">Choose the branch:</label>
		<select id="branch-option" class="select-branch">
			<option value=""></option>
			@foreach (var branch in Model.branches)
			{
				<option value="@branch.branchCode">@branch.name</option>
			}
		</select>
	</div>
	<form method="post" class="settings-form">
		<div class="form-veil"></div>
		<div class="form-wrapper">
			<details class="section-quotation-settings-wrapper" open>
				<summary class="section-quotation-settings-title">Quotation settings</summary>
				<div class="section-quotation-settings-content">
					<div class="setting-item">
						<p>Quotation type:</p>
						@foreach (var quotationType in Model.quotationTypes)
						{
							<div>
								<input type="radio" name="quotation-type" id="@($"quotation-type-{quotationType.id}")"
									   value="@quotationType.id" />
								<label for="@($"quotation-type-{quotationType.id}")">@quotationType.name</label>
							</div>
						}
					</div>
					<div class="setting-item">
						<p>Default tax rate:</p>
						<input type="number" class="input-default-tax-rate" />
						<p>%</p>
					</div>
					<div class="setting-item">
						<p>Header & Footer setting:</p>
						<select class="select-setting">
							<option value=""></option>
						</select>
					</div>
				</div>
			</details>
			<details class="section-discount-surcharge-wrapper" open>
				<summary class="section-discount-surcharge-title">Global discount and global surcharge</summary>
				<div class="section-discount-surcharge-content">
					<div class="setting-item">
						<p>Global discount:</p>
						<div class="setting-item">
							<input type="checkbox" name="global-discount" class="checkbox-has-global-discount"/>
							<input type="number" name="global-discount-percentage" class="input-global-discount"
								   disabled />
							<p>%</p>
						</div>
					</div>
					<div class="setting-item">
						<p>Global surcharge:</p>
						<div class="setting-item">
							<input type="checkbox" name="global-surcharge" class="checkbox-has-global-surcharge"/>
							<input type="number" name="global-surcharge-percentage" class="input-global-surcharge"
								   disabled />
							<p>%</p>
						</div>
					</div>
				</div>
			</details>
			<details class="section-document-settings-wrapper" open>
				<summary class="section-document-settings-title">Quotation document printing settings</summary>
				<div class="section-document-settings-content">
					<div class="setting-item">
						<input type="checkbox" name="page-break-before-quotation-table" class="checkbox-page-break-before-quotation-table"/>
						<p>Display a page break before the quotation table</p>
					</div>
					<div class="setting-item">
						<input type="checkbox" name="display-customer-details" class="checkbox-display-customer-details"/>
						<p>Display phone number, email address in the Customer details</p>
					</div>
					<div class="setting-item">
						<input type="checkbox" name="display-quantity-and-unit-price" class="checkbox-display-quantity-and-unit-price"/>
						<p>Display quantity and unit price columns</p>
					</div>
					<div class="setting-item">
						<input type="checkbox" name="page-break-after-quotation-table" class="checkbox-page-break-after-quotation-table"/>
						<p>Display a page break after the quotation table</p>
					</div>
					<div class="setting-item">
						<input type="checkbox" name="quotation-start-date" class="checkbox-quotation-start-date"/>
						<p>Display the quotation start date</p>
					</div>
					<div class="setting-item">
						<input type="checkbox" name="quotation-expiration-date" class="checkbox-quotation-expiration-date"/>
						<p>Display the quotation expiration date</p>
					</div>
					<div class="setting-item">
						<p>Customer acceptance signature box:</p>
						<div class="setting-item">
							@foreach (var boxChoice in Model.customerAcceptanceBoxChoices)
							{
								<div>
									<input type="radio" name="signature-box" id="@($"Choice-{boxChoice.id}")" value="@boxChoice.id"/>
									<label for="@($"Choice-{boxChoice.id}")">@boxChoice.name</label>
								</div>
							}
						</div>
					</div>
					<div class="setting-item">
						<p>Position of the quotation footer:</p>
						<div class="setting-item">
							@foreach (var position in Model.footerPositions)
							{
								<div>
									<input type="radio" name="quotation-footer-position"
										   id="@($"Position-{position.id}")" value="@position.id"/>
									<label for="@($"Position-{position.id}")">@position.name</label>
								</div>
							}
						</div>
					</div>
					<div class="setting-item">
						<p>Letter top template:</p>
						<select class="select-letter-top-template">
							@foreach (var template in Model.letterTopTemplates)
							{
								<option value="@template.id">@template.name</option>
							}
						</select>
					</div>
				</div>
			</details>
		</div>
		<div class="settings-action">
			<button class="btn-save" type="submit">
				<img src="~/images/icons8-save-100.png" width="30" height="30" alt="save-icon" />
			</button>
		</div>
	</form>
</div>
@await Html.PartialAsync("_LoadingPart")
@await Html.PartialAsync("_Popup")

<script src="~/js/branch-default-settings.js" defer></script>