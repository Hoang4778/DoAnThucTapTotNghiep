@model List<QuotationManagement.Models.HeaderFooterTemplate>

@{
}

<link rel="stylesheet" href="~/css/settings-header-footer-templates-index.css" />

<div class="section-wrapper">
	<div class="wrapper">
		<table width="100%">
			<tr>
				<th>Code</th>
				<th>Name</th>
				<th>Branch</th>
				<th>Language</th>
				<th>Usable as header</th>
				<th>Usable as footer</th>
				<th>Status</th>
			</tr>
			@foreach (var template in Model)
			{
				<tr>
					<td><a href="/settings/header-footer/templates/edit/@template.code" class="template-edit-link">@template.code</a></td>
					<td>@template.name</td>
					<td>@template.branchCode</td>
					<td>@template.languageName</td>
					<td>@template.usableAsHeader</td>
					<td>@template.usableAsFooter</td>
					<td>@template.status</td>
				</tr>
			}
		</table>
	</div>
	<div class="action-bar">
		<div class="wrapper">
			<a class="btn-add-template" href="/settings/header-footer/templates/create">
				<img src="~/images/icons8-plus-100.png" width="30" height="30" alt="add-template-icon" />
			</a>
		</div>
	</div>
</div>